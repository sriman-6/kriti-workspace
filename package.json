{
  "name": "kriti-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "KRITI Workspace — programmes, work and shared progress",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/reset.ts",
    "setup": "npm run db:migrate",
    "smoke": "tsx scripts/smoke.ts",
    "test:http": "tsx scripts/workspace-http-check.ts",
    "test:uploads-browser": "tsx scripts/workspace-upload-browser-check.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@vercel/blob": "2.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "jose": "^6.0.8",
    "lucide-react": "^0.475.0",
    "next": "^16.3.0",
    "next-themes": "^0.4.4",
    "postgres": "^3.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.20.1",
    "eslint-config-next": "^16.3.0",
    "playwright": "1.65.1",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.3"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "sharp@0.35.3": true
  }
}
