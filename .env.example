SESSION_SECRET=replace-with-a-long-random-secret
# Set DATABASE_URL for a hosted Postgres database. Omit for local PGlite.
# DATABASE_URL=postgres://...
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Local default: database. Vercel deployments require vercel-blob.
WORK_FILE_STORAGE=database
# Use a PRIVATE Blob store's server-only read/write token (required for client tokens).
# BLOB_READ_WRITE_TOKEN=
# Protects the scheduled abandoned-upload cleanup endpoint.
# CRON_SECRET=
# Local OAuth callback when using port 3001:
# http://localhost:3001/api/auth/callback
